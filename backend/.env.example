# Copy this file to backend/.env and fill in your values. backend/.env is git-ignored.

# MySQL
DB_URL=jdbc:mysql://localhost:3306/spring_boot_db?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Contact form email. For Gmail, MAIL_PASSWORD is a Google app password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
# Inbox that receives contact-form messages
CONTACT_RECIPIENT=you@gmail.com

# Frontend origin(s) allowed by CORS, comma-separated
FRONTEND_URL=http://localhost:5173
